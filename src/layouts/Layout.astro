---
import '../index.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Victorious Innovatech Solutions | Web Development & Design",
  description = "Victorious Innovatech Solutions provides expert web design, development, and digital solutions for businesses of all sizes."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="web development, web design, mobile apps, digital solutions, Victorious Innovatech Solutions" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Better Solutions For Your Digital Business. Custom web design, development, and mobile solutions." />
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="apple-touch-icon" href="/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-white text-slate-900 font-['Outfit',sans-serif] antialiased selection:bg-[#EA580C] selection:text-white">
    <slot />
  </body>
</html>
